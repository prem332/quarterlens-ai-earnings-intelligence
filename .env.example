# Copy to .env and fill in real values. Never commit .env.
#
# Resolution order (azure_clients/key_vault_client.py): every secret is
# looked up in Azure Key Vault first (if AZURE_KEY_VAULT_URL is set and
# reachable via DefaultAzureCredential), falling back to these environment
# variables. For local/container runs without Key Vault access, just fill
# these in directly and leave AZURE_KEY_VAULT_URL unset.

# Optional: use real Key Vault instead of the vars below (requires the
# container/host to have valid Azure credentials — az login, a managed
# identity, or service principal env vars that DefaultAzureCredential picks up)
AZURE_KEY_VAULT_URL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME_STANDARD=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX=quarterlens-filings

# Azure Cosmos DB (decision log)
AZURE_COSMOS_URI=
AZURE_COSMOS_KEY=

# Azure Cache for Redis (L2/L3 retrieval + report cache)
AZURE_REDIS_HOST=
AZURE_REDIS_KEY=

# Azure Blob Storage (serves raw source documents for citation display)
AZURE_BLOB_CONNECTION_STRING=

# Azure SQL (financial_facts table — numeric_validation_agent)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Observability — all optional, each degrades gracefully if unset
APPLICATIONINSIGHTS_CONNECTION_STRING=
PHOENIX_ENDPOINT=
PHOENIX_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# SEC EDGAR fetcher (data_pipeline/edgar_downloader.py, offline ingestion only
# — not required to run the API) — SEC requires a contact-identifying User-Agent
SEC_USER_AGENT=
